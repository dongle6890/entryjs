                    libDir: '',
                    entryDir: '',
                    type: 'workspace',
                    textCodingEnable: true,
                };
                Entry.creationChangedEvent = new Entry.Event(window);
                Entry.init(document.getElementById('workspace'), initOption);
                Entry.loadProject();
            });
        </script>
<!-- ENTRY ASSESS: paste immediately BEFORE </body> in example/example.ejs -->
<style>
#ea-data-tools{position:fixed;right:14px;top:48px;z-index:9999;display:flex;gap:7px;padding:9px;background:#fff;border:1px solid #ddd;border-radius:12px;box-shadow:0 3px 12px #0002;font-family:Arial,sans-serif}
#ea-data-tools button{padding:8px 11px;border:0;border-radius:7px;background:#2458d3;color:#fff;cursor:pointer;font-size:13px}
#ea-data-tools button:disabled{opacity:.5;cursor:wait}
</style>
<div id="ea-data-tools">
  <button id="ea-sample" type="button">예제 데이터 추가</button>
  <button id="ea-import" type="button">CSV 가져오기</button>
  <button id="ea-open" type="button">엔트리 데이터 분석 열기</button>
  <input id="ea-file" type="file" accept=".csv,text/csv" hidden>
</div>
<script>
(function () {
  'use strict';
  const $id = (id) => document.getElementById(id);
  const alertError = (e) => { console.error('[ENTRY ASSESS data]', e); alert('데이터 분석 오류: ' + (e.message || e)); };
  function tableAPI() {
    if (!window.Entry || !Entry.DataTable || !Entry.playground || !Entry.playground.mainWorkspace) {
      throw new Error('엔트리 편집기 초기화가 아직 완료되지 않았습니다.');
    }
    return Entry.DataTable;
  }
  function addTable(name, fields, data) {
    const api = tableAPI();
    if (!fields.length || !data.length) throw new Error('열 제목과 데이터가 필요합니다.');
    api.addSource({ name, fields, data }, true);
    // EntryJS addSource() updates the internal table list and unlocks analysis blocks.
  }
  // RFC4180-style quoted CSV parsing, including embedded commas and newlines.
  function parseCSV(text) {
    const rows = []; let row = [], field = '', quoted = false;
    text = text.replace(/^\uFEFF/, '');
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (quoted) {
        if (c === '"' && text[i + 1] === '"') { field += '"'; i++; }
        else if (c === '"') quoted = false;
        else field += c;
      } else if (c === '"' && field === '') quoted = true;
      else if (c === ',') { row.push(field); field = ''; }
      else if (c === '\n' || c === '\r') {
        if (c === '\r' && text[i + 1] === '\n') i++;
        row.push(field); field = '';
        if (row.some(v => v.trim() !== '')) rows.push(row);
        row = [];
      } else field += c;
    }
    if (quoted) throw new Error('CSV의 따옴표가 닫히지 않았습니다.');
    row.push(field);
    if (row.some(v => v.trim() !== '')) rows.push(row);
    return rows;
  }
  function run(fn) { try { fn(); } catch (e) { alertError(e); } }
  $id('ea-sample').addEventListener('click', () => run(() => {
    addTable('학생별 학습 시간', ['이름', '학습시간', '점수'], [
      ['가람', 2, 65], ['나래', 3, 72], ['다온', 4, 80],
      ['라온', 5, 88], ['마루', 6, 95]
    ]);
  }));
  $id('ea-open').addEventListener('click', () => run(() => {
    const api = tableAPI();
    api.show({ list: api.dataTables, selectedIndex: Math.max(0, api.dataTables.length - 1) });
  }));
  $id('ea-import').addEventListener('click', () => $id('ea-file').click());
  $id('ea-file').addEventListener('change', async (event) => {
    const file = event.target.files[0]; if (!file) return;
    try {
      const rows = parseCSV(await file.text());
      if (rows.length < 2) throw new Error('CSV에는 제목 행과 데이터 행이 필요합니다.');
      const fields = rows[0].map((x, i) => x.trim() || `열 ${i + 1}`);
      const data = rows.slice(1).map(row => fields.map((_, i) => {
        const raw = (row[i] || '').trim();
        return raw !== '' && /^-?(?:\d+\.?\d*|\.\d+)$/.test(raw) ? Number(raw) : raw;
      }));
      addTable(file.name.replace(/\.csv$/i, ''), fields, data);
    } catch (e) { alertError(e); }
    finally { event.target.value = ''; }
  });
})();
</script>
<!-- ENTRY ASSESS: EntryJS internal data table tools -->
<style>
  #ea-data-tools { position:fixed;right:14px;top:50px;z-index:99999;display:flex;gap:7px;align-items:center;padding:9px;background:#fff;border:1px solid #ccd5e0;border-radius:10px;box-shadow:0 4px 18px #0002;font:13px sans-serif; }
  #ea-data-tools button {background:#376cf5;color:#fff;border:0;border-radius:6px;padding:8px 10px;cursor:pointer}
  #ea-data-tools button:focus-visible{outline:2px solid #111}
  #ea-data-tools-status {max-width:260px;font-size:12px;color:#344054}
</style>
<div id="ea-data-tools">
  <button type="button" id="ea-example">예제 데이터 추가</button>
  <button type="button" id="ea-csv">CSV 가져오기</button>
  <input type="file" id="ea-csv-file" accept=".csv,text/csv" hidden>
  <span id="ea-data-tools-status" role="status" aria-live="polite"></span>
</div>
<script>
(function () {
  'use strict';
  const status = document.getElementById('ea-data-tools-status');
  const fileInput = document.getElementById('ea-csv-file');
  function message(text, error) { status.textContent = text; status.style.color = error ? '#b42318' : '#344054'; }
  function manager() {
    const dt = window.Entry && Entry.playground && Entry.playground.dataTable;
    if (!dt || typeof dt.addSources !== 'function' || typeof dt.setSource !== 'function') {
      throw new Error('엔트리 데이터 분석 기능이 아직 준비되지 않았습니다.');
    }
    return dt;
  }
  function addData(name, rows) {
    if (!Array.isArray(rows) || rows.length < 2 || rows[0].length === 0) {
      throw new Error('제목 행과 데이터 행이 각각 1개 이상 필요합니다.');
    }
    const width = rows[0].length;
    if (rows.some(row => row.length !== width)) throw new Error('CSV 행마다 열 개수가 다릅니다.');
    const dt = manager();
    const oldCount = dt.dataTables.length;
    dt.addSources([{ name }]);
    const selected = dt.dataTables[dt.dataTables.length - 1];
    if (!selected || dt.dataTables.length !== oldCount + 1) throw new Error('테이블을 생성하지 못했습니다.');
    try {
      dt.setSource({ selected, id: selected.id, name, chart: [], table: rows });
      const saved = dt.getTableJSON().find(item => item.id === selected.id);
      if (!saved || !Array.isArray(saved.data) || saved.data.length !== rows.length - 1) {
        throw new Error('엔트리 테이블 저장 결과를 확인할 수 없습니다.');
      }
      if (window.Entry && Entry.playground && typeof Entry.playground.reloadPlayground === 'function') {
        Entry.playground.reloadPlayground();
      }
      dt.hide();
      dt.show({ list: dt.dataTables, selectedIndex: dt.dataTables.length - 1 });
      message(name + ' — ' + saved.data.length + '행 추가 완료');
    } catch (err) {
      message('테이블 생성 후 저장 실패: ' + err.message, true);
      throw err;
    }
  }
  // RFC 4180-style CSV parser: supports quoted commas, escaped quotes and multiline cells.
  function parseCSV(text) {
    const rows = []; let row = [], field = '', quoted = false;
    text = text.replace(/^\uFEFF/, '');
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (quoted) {
        if (c === '"' && text[i + 1] === '"') { field += '"'; i++; }
        else if (c === '"') quoted = false;
        else field += c;
      } else if (c === '"' && field === '') quoted = true;
      else if (c === ',') { row.push(field); field = ''; }
      else if (c === '\n' || c === '\r') {
        if (c === '\r' && text[i + 1] === '\n') i++;
        row.push(field); rows.push(row); row = []; field = '';
      } else field += c;
    }
    if (quoted) throw new Error('CSV 따옴표가 닫히지 않았습니다.');
    if (field !== '' || row.length) { row.push(field); rows.push(row); }
    return rows.filter(r => r.some(cell => cell !== ''));
  }
  document.getElementById('ea-example').addEventListener('click', function () {
    try {
      addData('학생 성적 예제 ' + new Date().toLocaleTimeString('ko-KR'), [
        ['이름', '국어', '수학', '정보'],
        ['김학생', 85, 90, 95],
        ['이학생', 70, 88, 92],
        ['박학생', 95, 80, 100]
      ]);
    } catch (err) { message(err.message, true); console.error(err); }
  });
  document.getElementById('ea-csv').addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', async function () {
    const file = this.files && this.files[0];
    if (!file) return;
    try {
      if (file.size > 2 * 1024 * 1024) throw new Error('CSV 파일은 2MB 이하만 지원합니다.');
      const rows = parseCSV(await file.text());
      addData(file.name.replace(/\.csv$/i, ''), rows);
    } catch (err) { message(err.message, true); console.error(err); }
    finally { this.value = ''; }
  });
})();
</script>

